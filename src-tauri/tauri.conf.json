{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LingoReel",
  "version": "0.5.0",
  "identifier": "com.lingoreel.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LingoReel",
        "width": 1400,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "transparent": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$APPLOCALDATA/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzODQ2NDlFQTAwNUQ5OTUKUldTVjJRV2dubVNFd3gwNGF3b29iRUFPeEFkQS80U3NnNFpucDMyRTRHczB0bTJ3eFduMlFiTUcK",
      "endpoints": ["https://github.com/JustSad42/LingoReel/releases/latest/download/latest.json"]
    }
  }
}
